# Public Supabase values from the Slipwell Phase 0 project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical public application URL, without a trailing path. Used for safe auth callbacks in deployed environments.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# Only needed when running the local Supabase stack with Google OAuth enabled.
# Configure the hosted provider credentials in the Supabase dashboard; never commit either secret.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Server-only OpenRouter configuration. Keep these out of git and browser bundles.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional comma-separated fallback model IDs. Every selected route must support ZDR + JSON mode.
OPENROUTER_FALLBACK_MODELS=

# Optional server-only OpenRouter speech-to-text model. Audio is sent only when
# a user submits a recording; Slipwell does not store the recording in Supabase.
# Defaults to openai/gpt-4o-transcribe.
OPENROUTER_TRANSCRIPTION_MODEL=
